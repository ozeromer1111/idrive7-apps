{
  "id": "cluster-render",
  "kind": "tool",
  "version": "0.6.0",
  "title": "Gösterge / HUD çizim motoru",
  "description": "Uygulamaların gösterge paneline ve HUD'a (cam yansıtma) çizmesini sağlar; Devir Sınırı'nın HUD'u bunu kullanır",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "mgu-deploy": "0.4.0"
  },
  "uninstallable": true,
  "files": [
    {
      "path": "cluster-render",
      "mode": "0755"
    },
    {
      "path": "cluster-render-idrive7",
      "mode": "0755"
    },
    {
      "path": "cluster-render-idrive8",
      "mode": "0755"
    },
    {
      "path": "cluster-render.conf",
      "mode": "0644"
    },
    {
      "path": "cluster_render_client.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    },
    {
      "path": "LICENSE.MPL-2.0",
      "mode": "0644"
    },
    {
      "path": "NOTICE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "cluster-render.socket"
    },
    {
      "name": "cluster-render.service"
    }
  ],
  "enable": [
    {
      "unit": "cluster-render.socket",
      "target": "sockets.target"
    }
  ],
  "recmgr": [
    "cluster-render"
  ],
  "restart": [
    "cluster-render.service"
  ]
}
